# Скопируйте в .env (локально) или внесите в настройки хостинга
ADMIN_PASSWORD=придумайте-длинный-пароль
SESSION_SECRET=любая-длинная-случайная-строка
SITE_NAME=ATELIER
INSTAGRAM_URL=https://instagram.com/ваш_аккаунт

# MAX (основной канал заявок)
MAX_BOT_TOKEN=
MAX_USER_ID=

# Telegram (необязательно, запасной канал)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Папка для товаров и фото (на хостинге — путь к подключённому диску, например /data)
DATA_DIR=./data
